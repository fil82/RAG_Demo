# Copy to .env and adjust as needed.

# Elasticsearch
ELASTICSEARCH_URL=http://localhost:9200
ELASTICSEARCH_INDEX=documents

# Embeddings
EMBEDDING_MODEL=BAAI/bge-m3
EMBEDDING_DIM=1024

# Chunking
CHUNK_SIZE=512
CHUNK_OVERLAP=100

# Retrieval
DEFAULT_TOP_K=5
# hybrid (dense+BM25 via RRF) | dense | bm25
RETRIEVAL_MODE=hybrid
RRF_K=60
RRF_CANDIDATES=5

# HNSW index tuning
# type: int8_hnsw | int4_hnsw | hnsw | bbq_hnsw | flat
HNSW_TYPE=int8_hnsw
HNSW_M=32
HNSW_EF_CONSTRUCTION=512

# Observability
LOG_LEVEL=INFO
